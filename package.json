{
  "name": "bardboardjs",
  "version": "3.0.0",
  "main": "server/app.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:bot\" \"npm:dev:web\"",
    "dev:bot": "node server/app.js",
    "dev:web": "next dev",
    "build": "next build",
    "start": "concurrently -k \"npm:start:bot\" \"npm:start:web\"",
    "start:bot": "node server/app.js",
    "start:web": "next start",
    "lint": "eslint .",
    "test": "node --test"
  },
  "keywords": [
    "nodejs",
    "dnd",
    "dungeons",
    "dragons",
    "dungeon",
    "dragon",
    "soundboard",
    "discord",
    "bot",
    "discordjs"
  ],
  "author": "github.com/giabb",
  "license": "GPL-3.0-or-later",
  "description": "Soundboard for DND sessions (or whatever you like)",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "libsodium-wrappers": "^0.8.4",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3",
    "next": "^16.2.7",
    "opusscript": "^0.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "session-file-store": "^1.5.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7"
  }
}
